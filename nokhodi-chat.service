[Unit]
Description=اتاق نخودی — self-hosted chat room
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nokhodi-chat
ExecStart=/opt/nokhodi-chat/nokhodi-chat -config /opt/nokhodi-chat/config.json
Restart=on-failure
RestartSec=3
# config.json and data/ live in the working directory and are never
# touched by an update — only the binary is replaced.

[Install]
WantedBy=multi-user.target
